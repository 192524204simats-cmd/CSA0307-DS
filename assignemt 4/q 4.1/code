/* Task 4.1 - equal marks change order with the original quicksort; merge sort keeps it */
#include <stdio.h>
typedef struct { int marks; char name; } Script;
void swapS(Script *a, Script *b) { Script t = *a; *a = *b; *b = t; }
void quick(Script a[], int lo, int hi)
{
    if (lo >= hi) return;
    int p = a[hi].marks, i = lo - 1;
    for (int j = lo; j < hi; j++) if (a[j].marks <= p) { i++; swapS(&a[i], &a[j]); }
    swapS(&a[i + 1], &a[hi]);
    quick(a, lo, i); quick(a, i + 2, hi);
}
void msort(Script a[], Script t[], int lo, int hi)
{
    if (lo >= hi) return;
    int mid = (lo + hi) / 2;
    msort(a, t, lo, mid); msort(a, t, mid + 1, hi);
    int i = lo, j = mid + 1, k = lo;
    while (i <= mid && j <= hi) t[k++] = (a[i].marks <= a[j].marks) ? a[i++] : a[j++];
    while (i <= mid) t[k++] = a[i++];
    while (j <= hi) t[k++] = a[j++];
    for (k = lo; k <= hi; k++) a[k] = t[k];
}
int main(void)
{
    Script s[] = {{80,'A'},{90,'B'},{80,'C'},{70,'D'},{80,'E'},{90,'F'}};
    Script u[6], t[6];
    for (int i = 0; i < 6; i++) u[i] = s[i];
    quick(s, 0, 5);
    printf("original quicksort: ");
    for (int i = 0; i < 6; i++) printf("%c%d ", s[i].name, s[i].marks);
    msort(u, t, 0, 5);
    printf("\nmerge sort        : ");
    for (int i = 0; i < 6; i++) printf("%c%d ", u[i].name, u[i].marks);
    printf("\n");
    return 0;
}
