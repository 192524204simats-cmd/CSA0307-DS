#include <stdio.h>
#define MAX 32
typedef struct { int severity; int patient; int arrival; } Case;
Case heap[MAX];
int size = 0, counter = 0;

/* a is served before b if more severe, or equal severity and arrived earlier */
int before(Case a, Case b)
{
    if (a.severity != b.severity) return a.severity > b.severity;
    return a.arrival < b.arrival;
}
void swap(Case *a, Case *b) { Case t = *a; *a = *b; *b = t; }

void push(int severity, int patient)
{
    if (size == MAX) return;
    heap[size] = (Case){severity, patient, counter++};
    int i = size++;
    while (i > 0 && before(heap[i], heap[(i - 1) / 2])) {
        swap(&heap[i], &heap[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}
Case pop(void)
{
    Case top = heap[0];
    heap[0] = heap[--size];
    int i = 0;
    for (;;) {
        int l = 2 * i + 1, r = l + 1, best = i;
        if (l < size && before(heap[l], heap[best])) best = l;
        if (r < size && before(heap[r], heap[best])) best = r;
        if (best == i) break;
        swap(&heap[i], &heap[best]);
        i = best;
    }
    return top;
}
int main(void)
{
    int sev[] = {5, 9, 5, 9, 5, 2};
    for (int p = 0; p < 6; p++) push(sev[p], 101 + p);
    while (size) { Case c = pop(); printf("P%d(%d) ", c.patient, c.severity); }
    printf("\n");
    return 0;
}
