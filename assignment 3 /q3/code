#include <stdio.h>
#include <stdlib.h>

#define MIN_DEG 2   /* at most 3 keys and 4 children in a node */

typedef struct BNode {
    int n;                          /* number of keys */
    int key[2 * MIN_DEG - 1];
    struct BNode *child[2 * MIN_DEG];
    int leaf;
} BNode;

BNode *new_node(int leaf)
{
    BNode *x = (BNode *)calloc(1, sizeof(BNode));
    x->leaf = leaf;
    return x;
}

/* returns 1 if found; *reads = number of nodes visited (one disk read each) */
int search(BNode *x, int k, int *reads)
{
    int i;
    *reads = 0;
    while (x != NULL) {
        (*reads)++;
        i = 0;
        while (i < x->n && k > x->key[i]) i++;
        if (i < x->n && k == x->key[i]) return 1;
        if (x->leaf) return 0;
        x = x->child[i];
    }
    return 0;
}

/* split the full child x->child[i] */
void split_child(BNode *x, int i)
{
    int j;
    BNode *y = x->child[i];
    BNode *z = new_node(y->leaf);
    z->n = MIN_DEG - 1;
    for (j = 0; j < MIN_DEG - 1; j++) z->key[j] = y->key[j + MIN_DEG];
    if (!y->leaf)
        for (j = 0; j < MIN_DEG; j++) z->child[j] = y->child[j + MIN_DEG];
    y->n = MIN_DEG - 1;
    for (j = x->n; j >= i + 1; j--) x->child[j + 1] = x->child[j];
    x->child[i + 1] = z;
    for (j = x->n - 1; j >= i; j--) x->key[j + 1] = x->key[j];
    x->key[i] = y->key[MIN_DEG - 1];   /* middle key moves up */
    x->n++;
}

void insert_nonfull(BNode *x, int k)
{
    int i = x->n - 1;
    if (x->leaf) {
        while (i >= 0 && k < x->key[i]) {
            x->key[i + 1] = x->key[i];
            i--;
        }
        x->key[i + 1] = k;
        x->n++;
    } else {
        while (i >= 0 && k < x->key[i]) i--;
        i++;
        if (x->child[i]->n == 2 * MIN_DEG - 1) {
            split_child(x, i);
            if (k > x->key[i]) i++;
        }
        insert_nonfull(x->child[i], k);
    }
}

BNode *insert(BNode *root, int k)
{
    BNode *s;
    if (root == NULL) {
        root = new_node(1);
        root->key[0] = k;
        root->n = 1;
        return root;
    }
    if (root->n == 2 * MIN_DEG - 1) {   /* root is full: tree grows in height */
        s = new_node(0);
        s->child[0] = root;
        split_child(s, 0);
        root = s;
    }
    insert_nonfull(root, k);
    return root;
}

void print_tree(BNode *x, int depth)
{
    int i;
    if (x == NULL) return;
    for (i = 0; i < depth; i++) printf("    ");
    printf("[");
    for (i = 0; i < x->n; i++) {
        if (i > 0) printf(" ");
        printf("%d", x->key[i]);
    }
    printf("]\n");
    if (!x->leaf)
        for (i = 0; i <= x->n; i++) print_tree(x->child[i], depth + 1);
}

void destroy(BNode *x)
{
    int i;
    if (x == NULL) return;
    if (!x->leaf)
        for (i = 0; i <= x->n; i++) destroy(x->child[i]);
    free(x);
}

/* smallest h such that base^h >= n */
int levels(double n, double base)
{
    int h = 0;
    double p = 1;
    while (p < n) {
        p = p * base;
        h++;
    }
    return h;
}

int main(void)
{
    int keys[8] = {10, 20, 5, 6, 12, 30, 7, 17};
    int tests[4] = {5, 30, 15, 17};
    int i, r, found, bst, bt;
    BNode *root = NULL;

    printf("Insertion, tree after every key\n");
    for (i = 0; i < 8; i++) {
        root = insert(root, keys[i]);
        printf("\nafter inserting %d:\n", keys[i]);
        print_tree(root, 0);
    }

    printf("\nSearch tests (reads = nodes visited)\n");
    for (i = 0; i < 4; i++) {
        found = search(root, tests[i], &r);
        printf("search %2d: %s, disk reads = %d\n", tests[i], found ? "found" : "not found", r);
    }

    printf("\n5 million keys, 10 ms per disk read\n");
    bst = levels(5000000.0, 2.0);
    bt = levels(5000000.0, 100.0);
    printf("balanced BST / AVL : about %d reads = %d ms\n", bst, bst * 10);
    printf("B-tree of order 100: about %d reads = %d ms\n", bt, bt * 10);

    destroy(root);
    return 0;
}
